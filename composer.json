{
    "name": "kadegray/statamic-country-and-region-fieldtypes",
    "description": "Statamic Country And Region Fieldtype addon",
    "authors": [
        {
            "name": "Kade Gray"
        }
    ],
    "autoload": {
        "psr-4": {
            "Kadegray\\StatamicCountryAndRegionFieldtypes\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kadegray\\StatamicCountryAndRegionFieldtypes\\Tests\\": "tests"
        }
    },
    "extra": {
        "statamic": {
            "name": "Statamic Country And Region Fieldtypes",
            "description": "Statamic Country And Region Fieldtypes is an addon that is everything you need to store and display Country and Region on your site."
        },
        "laravel": {
            "providers": [
                "Kadegray\\StatamicCountryAndRegionFieldtypes\\ServiceProvider"
            ]
        }
    },
    "require": {
        "sokil/php-isocodes": "^4.1",
        "sokil/php-isocodes-db-i18n": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    },
    "require-dev": {
        "statamic/cms": "^6.0",
        "orchestra/testbench": "^9.0 || ^10.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    }
}